__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store

# Local project metadata: category, working path, anything describing the machine this
# is maintained from rather than the project itself. tests/test_no_local_leakage.py is the
# enforcement; this is the designated place to put such things so they have somewhere to go.
GARAGE.md
NOTES.local.md
*.local.md

# Agent-harness overrides scoped to one machine: permission grants, local model or
# tool choices. `.claude/` itself is deliberately NOT ignored — shared project config
# belongs in the repo and should be reviewable. Only the `.local.` files are personal,
# the same split `*.local.md` above already draws.
.claude/*.local.json

# Session ledgers and reference-memory files written during play are local
# campaign state, not source. The formats are versioned; the contents are not.
/ledgers/
/campaigns/
